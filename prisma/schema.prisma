// 7sCstore data model — implements SRS Section 5 (key entities).
// Designed for a single location now (A2) but every operational record carries a
// locationId so additional sites can be added later with no schema redesign.
//
// Postgres (Supabase). DATABASE_URL uses the pooled connection for the app;
// DIRECT_URL uses the direct/session connection for migrations & db push.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  OWNER // Owner / Admin — full access
  MANAGER
  ACCOUNTANT
  EMPLOYEE
}

enum SaleCategory {
  FUEL
  STORE // Store / grocery
  LOTTERY
  TOBACCO
  FOOD_DRINK
  OTHER
}

enum PaymentType {
  CASH
  CARD
  CHECK
  OTHER
}

enum FuelGrade {
  REGULAR
  MID
  PREMIUM
  DIESEL
}

// Every transactional record records where it came from. This is the
// "integration layer" seam (FR-41): manual + CSV today, Modi POS API later,
// without touching reports or calculations.
enum DataSource {
  MANUAL
  CSV_IMPORT
  POS_MODI
}

enum ExpenseCategory {
  RENT_MORTGAGE
  PAYROLL
  UTILITIES
  INTERNET_PHONE
  REPAIRS_MAINTENANCE
  STORE_OPERATING_EXPENSES
  INSURANCE
  VENDOR_PAYMENT
  FUEL_PURCHASE
  PRODUCT_PURCHASE
  INVENTORY_PURCHASE
  BANK_FEES
  CARD_PROCESSING_FEES
  OTHER
}

// ---------------------------------------------------------------------------
// Core / identity
// ---------------------------------------------------------------------------

model Location {
  id        String   @id @default(cuid())
  name      String
  address   String?
  createdAt DateTime @default(now())

  users          User[]
  sales          Sale[]
  fuelSales      FuelSale[]
  expenses       Expense[]
  purchases      Purchase[]
  shifts         Shift[]
  fuelInventory  FuelInventory[]
  products       Product[]
  fuelDeliveries FuelDelivery[]
  alerts         Alert[]
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(EMPLOYEE)
  active       Boolean  @default(true)
  locationId   String?
  location     Location? @relation(fields: [locationId], references: [id])
  createdAt    DateTime @default(now())

  sales     Sale[]
  expenses  Expense[]
  purchases Purchase[]
  shifts    Shift[]
  auditLogs AuditLog[]

  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Sales
// ---------------------------------------------------------------------------

model Sale {
  id           String       @id @default(cuid())
  date         DateTime
  locationId   String
  location     Location     @relation(fields: [locationId], references: [id])
  category     SaleCategory
  paymentType  PaymentType
  amount       Float // Gross sale value, excluding sales tax (Section 3)
  taxCollected Float        @default(0) // Tracked separately — liability, not revenue (FR-13)
  refund       Float        @default(0) // Refunds/voids reduce net sales (FR-14)
  // Lottery is commission income only (FR-32). For LOTTERY rows, `amount`
  // holds the commission earned; face value/payouts are pass-through and excluded.
  note         String?
  source       DataSource   @default(MANUAL)
  shiftId      String?
  shift        Shift?       @relation(fields: [shiftId], references: [id])
  enteredById  String?
  enteredBy    User?        @relation(fields: [enteredById], references: [id])
  fuelSale     FuelSale?
  createdAt    DateTime     @default(now())

  @@index([locationId, date])
  @@index([category])
  @@index([paymentType])
}

// Fuel sale detail (FR-9). One-to-one with a FUEL-category Sale so that fuel
// rolls up into the same sales totals while keeping per-grade volume/price.
model FuelSale {
  id            String    @id @default(cuid())
  saleId        String    @unique
  sale          Sale      @relation(fields: [saleId], references: [id], onDelete: Cascade)
  date          DateTime
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id])
  grade         FuelGrade
  gallons       Float
  pricePerGallon Float // pump price, 4-decimal precision (NFR-2)
  total         Float
  taxPerGallon  Float    @default(0) // fuel taxes embedded in pump price (Section 3)
  costPerGallon Float    @default(0) // cost basis for margin; defaults from latest delivery

  @@index([locationId, date])
  @@index([grade])
}

// ---------------------------------------------------------------------------
// Expenses
// ---------------------------------------------------------------------------

model Expense {
  id            String          @id @default(cuid())
  date          DateTime
  locationId    String
  location      Location        @relation(fields: [locationId], references: [id])
  category      ExpenseCategory
  amount        Float
  payee         String?
  checkNo       String? // check number (used for Inventory Purchases paid by check)
  paymentMethod PaymentType     @default(CASH)
  note          String?
  receiptUrl    String? // optional receipt attachment (FR-18)
  recurring     Boolean         @default(false) // recurring flag for reminders (FR-21)
  source        DataSource      @default(MANUAL)
  enteredById   String?
  enteredBy     User?           @relation(fields: [enteredById], references: [id])
  createdAt     DateTime        @default(now())

  @@index([locationId, date])
  @@index([category])
}

// User-added dropdown options for the expense form, so staff can extend the
// "Expense type" and "Vendor" lists inline without a code change. Seeded base
// lists live in src/lib/expenseOptions.ts; these are the custom additions.
model ExpenseOption {
  id         String   @id @default(cuid())
  locationId String
  kind       String // "EXPENSE_TYPE" | "VENDOR"
  value      String
  createdAt  DateTime @default(now())

  @@unique([locationId, kind, value])
  @@index([locationId, kind])
}

// Per-day sales summary imported from the legacy Excel "daily sheet". These are
// the authoritative day figures the Monthly Sales view shows for historical
// days (mapped: dailySales=Inside Sales/AL, fuel=Gasoline/H, lotto+lottery=I+J,
// total=Z-Tape/C, credit=T, cash=R, shortOver=AO). Kept separate from the
// transactional Sale rows because the Excel totals don't decompose the same way.
model DailySalesSummary {
  id            String     @id @default(cuid())
  locationId    String
  date          DateTime
  dailySales    Float      @default(0)
  fuel          Float      @default(0)
  lotto         Float      @default(0)
  lottery       Float      @default(0)
  lotteryPayout Float      @default(0)
  total         Float      @default(0)
  credit        Float      @default(0)
  cash          Float      @default(0)
  shortOver     Float      @default(0)
  source        DataSource @default(CSV_IMPORT)
  createdAt     DateTime   @default(now())

  @@unique([locationId, date])
  @@index([locationId, date])
}

// Non-sales income (Excel "Money_incoming"): rent, game-machine credit, Stagity
// investment, beer. Shown in its own Money Incoming section.
model MoneyIncoming {
  id                String     @id @default(cuid())
  locationId        String
  date              DateTime
  rent              Float      @default(0)
  gameMachine       Float      @default(0)
  stagityInvestment Float      @default(0)
  beer              Float      @default(0)
  total             Float      @default(0)
  source            DataSource @default(CSV_IMPORT)
  createdAt         DateTime   @default(now())

  @@index([locationId, date])
}

// Owner profit distributions ("Profit Taken Out") — money the owner withdraws
// from the business's net profit. A manual ledger with a running total.
model ProfitDraw {
  id          String     @id @default(cuid())
  locationId  String
  date        DateTime
  amount      Float
  note        String?
  source      DataSource @default(MANUAL)
  enteredById String?
  createdAt   DateTime   @default(now())

  @@index([locationId, date])
}

// Imported monthly P&L summary (Excel "Monthly_summary_*"). One row per
// (year, category) with the 12 monthly values + annual total, in source order.
model MonthlySummary {
  id         String     @id @default(cuid())
  locationId String
  year       Int
  category   String
  sortOrder  Int        @default(0)
  months     Json // array of 12 numbers, Jan..Dec
  annual     Float      @default(0)
  source     DataSource @default(CSV_IMPORT)
  createdAt  DateTime   @default(now())

  @@unique([locationId, year, category])
  @@index([locationId, year])
}

// ---------------------------------------------------------------------------
// Products, purchases, vendors, inventory
// ---------------------------------------------------------------------------

model Product {
  id           String       @id @default(cuid())
  locationId   String
  location     Location     @relation(fields: [locationId], references: [id])
  name         String
  category     SaleCategory @default(STORE)
  posItemId    Int? // Modisoft ItemKey — stable match key for POS sync
  posDeptId    Int? // Modisoft merchandise department id (needed to push prices)
  department   String? // Modisoft department name
  upc          String? // barcode / SKU — maps POS sales back to this product
  vendorId     String? // preferred supplier
  vendor       Vendor?      @relation(fields: [vendorId], references: [id])
  unitsPerCase Int          @default(1) // units in a case/carton/box you buy
  caseCost     Float        @default(0) // wholesale cost per case
  currentCost  Float        @default(0) // Average UNIT cost basis (Section 3, Average Cost)
  marginPct    Float? // target margin %, null = category default
  sellingPrice Float        @default(0) // retail price per unit
  qtyOnHand    Float        @default(0) // units in stock
  lowThreshold Float? // reorder point — the "warning number" (units)
  parLevel     Float? // order-up-to level (units)
  source       DataSource   @default(MANUAL)
  createdAt    DateTime     @default(now())

  purchases Purchase[]

  @@unique([locationId, posItemId])
  @@index([locationId])
  @@index([vendorId])
}

model Vendor {
  id          String     @id @default(cuid())
  name        String
  contact     String?
  terms       String? // payment terms (FR-23)
  balanceOwed Float      @default(0) // outstanding balance (FR-25)
  createdAt   DateTime   @default(now())
  purchases   Purchase[]
  products    Product[]
}

model Purchase {
  id          String   @id @default(cuid())
  locationId  String
  location    Location @relation(fields: [locationId], references: [id])
  vendorId    String?
  vendor      Vendor?  @relation(fields: [vendorId], references: [id])
  invoiceNo   String?
  date        DateTime
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  qty         Float
  costEach    Float
  total       Float
  sellPrice   Float    @default(0)
  paid        Boolean  @default(false)
  source      DataSource @default(MANUAL)
  enteredById String?
  enteredBy   User?    @relation(fields: [enteredById], references: [id])
  createdAt   DateTime @default(now())

  @@index([locationId, date])
  @@index([vendorId])
}

// Fuel deliveries tracked separately from store purchases (FR-24).
model FuelDelivery {
  id            String    @id @default(cuid())
  locationId    String
  location      Location  @relation(fields: [locationId], references: [id])
  vendorId      String?
  date          DateTime
  grade         FuelGrade
  gallons       Float
  costPerGallon Float
  taxPerGallon  Float     @default(0)
  total         Float
  invoiceNo     String?
  createdAt     DateTime  @default(now())

  @@index([locationId, date])
  @@index([grade])
}

model Shift {
  id           String    @id @default(cuid())
  locationId   String
  location     Location  @relation(fields: [locationId], references: [id])
  date         DateTime
  userId       String?
  user         User?     @relation(fields: [userId], references: [id])
  startTime    DateTime?
  endTime      DateTime?
  openCash     Float     @default(0)
  closeCash    Float     @default(0)
  expectedCash Float     @default(0) // sales - card - payouts (FR-16)
  variance     Float     @default(0) // closeCash - expectedCash; +over / -short
  cashDrop     Float     @default(0) // cash drops to safe/bank (FR-17)
  note         String?
  createdAt    DateTime  @default(now())

  sales Sale[]

  @@index([locationId, date])
}

model FuelInventory {
  id             String    @id @default(cuid())
  locationId     String
  location       Location  @relation(fields: [locationId], references: [id])
  grade          FuelGrade
  date           DateTime
  gallonsBook    Float // computed book figure
  gallonsPhysical Float // physical tank reading
  variance       Float    @default(0) // physical - book
  createdAt      DateTime  @default(now())

  @@index([locationId, date])
  @@index([grade])
}

// ---------------------------------------------------------------------------
// Audit + alerts
// ---------------------------------------------------------------------------

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String // CREATE / UPDATE / DELETE / LOGIN ...
  entity    String // e.g. "Sale", "Expense"
  entityId  String?
  before    String? // JSON snapshot
  after     String? // JSON snapshot
  timestamp DateTime @default(now())

  @@index([entity, entityId])
  @@index([timestamp])
}

model Alert {
  id         String    @id @default(cuid())
  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])
  type       String // MISSING_SALES / LOW_PROFIT / HIGH_EXPENSE / LOW_INVENTORY ...
  severity   String    @default("info") // info | warning | error
  message    String
  read       Boolean   @default(false)
  createdAt  DateTime  @default(now())

  @@index([locationId, read])
}

// Owner-configurable alert thresholds (FR-39).
model AlertSetting {
  id        String  @id @default(cuid())
  key       String  @unique // e.g. "lowProfitDay", "highExpense"
  value     Float
  enabled   Boolean @default(true)
}

// ---------------------------------------------------------------------------
// Phase 2/3 — integrations, notifications, payroll, banking
// ---------------------------------------------------------------------------

enum SyncStatus {
  RUNNING
  SUCCESS
  FAILED
}

// Generic key/value settings store for misc config (notification recipients,
// POS endpoint, AI/email/SMS toggles). String-typed so it complements the
// numeric AlertSetting table.
model Setting {
  id      String  @id @default(cuid())
  key     String  @unique
  value   String
  enabled Boolean @default(true)
}

// One row per POS / import sync run — powers the sync-status log and the
// failure alert (FR-43). The integration layer (FR-41) writes Sales with
// source = POS_MODI; reports never change.
model SyncLog {
  id              String     @id @default(cuid())
  source          DataSource @default(POS_MODI)
  status          SyncStatus @default(RUNNING)
  locationId      String?
  startedAt       DateTime   @default(now())
  finishedAt      DateTime?
  recordsImported Int        @default(0)
  message         String?

  @@index([startedAt])
}

// Payroll *tracking* (recording hours/wages), not processing — within scope of
// the SRS which excludes payroll processing.
model Employee {
  id         String   @id @default(cuid())
  locationId String
  name       String
  position   String?
  hourlyRate Float    @default(0)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  payroll PayrollEntry[]

  @@index([locationId])
}

model PayrollEntry {
  id          String   @id @default(cuid())
  locationId  String
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  hours       Float    @default(0)
  grossPay    Float    @default(0)
  note        String?
  createdAt   DateTime @default(now())

  @@index([locationId, periodStart])
  @@index([employeeId])
}

// Imported bank-statement lines, matched against recorded expenses (Phase 3).
model BankTransaction {
  id              String     @id @default(cuid())
  locationId      String
  date            DateTime
  description     String
  amount          Float // positive number; `kind` gives direction
  kind            String     @default("DEBIT") // DEBIT (money out) | CREDIT (money in)
  matched         Boolean    @default(false)
  matchedExpenseId String?
  source          DataSource @default(CSV_IMPORT)
  createdAt       DateTime   @default(now())

  @@index([locationId, date])
  @@index([matched])
}

// ---------------------------------------------------------------------------
// Vendor order imports (GSC) + per-department pricing policy
// ---------------------------------------------------------------------------

/**
 * One line item from an imported vendor order (GSC printable order PDF).
 * Every order ever uploaded is kept; the price comparison picks the row with
 * the highest `orderSeq` per product, so re-uploading the whole order history
 * converges on the newest cost for each item.
 */
model VendorOrderLine {
  id           String   @id @default(cuid())
  locationId   String
  vendor       String   @default("GSC")
  orderId      String // vendor's order id, as printed
  orderSeq     Int // numeric form of orderId — "latest order" ordering key
  sku          String // vendor item number
  upc          String // exactly as printed (14-digit GTIN)
  upcNorm      String // leading zeros stripped — the key products match on
  description  String
  quantity     Float    @default(0) // cases ordered
  unitsPerCase Float    @default(1) // sellable units in a case
  sizeLabel    String? // e.g. "12 PK", "4 OZ", "EACH"
  caseCost     Float    @default(0) // vendor "Unit Cost" = cost of a CASE
  lineCost     Float    @default(0) // quantity x caseCost, as printed
  unitCost     Float    @default(0) // caseCost / unitsPerCase
  srp          Float    @default(0) // vendor suggested retail, per unit
  orderedAt    DateTime? // order date when the document carries one
  importedAt   DateTime @default(now())

  @@unique([locationId, vendor, orderId, sku])
  @@index([locationId, upcNorm])
  @@index([locationId, vendor, orderSeq])
}

/**
 * Target gross margin per POS department, set by the owner. Departments are the
 * granularity that matters in a c-store: candy carries 40% while cigarettes run
 * far thinner, so a single store-wide number would price tobacco out of the
 * market. Unset departments fall back to the app default.
 */
model DepartmentMargin {
  id         String   @id @default(cuid())
  locationId String
  department String
  marginPct  Float    @default(40)
  updatedAt  DateTime @default(now()) @updatedAt

  @@unique([locationId, department])
  @@index([locationId])
}

// ---------------------------------------------------------------------------
// Demand history + automatic reordering
// ---------------------------------------------------------------------------

/**
 * A point-in-time reading of the POS's cumulative units-sold counter.
 *
 * Modisoft doesn't maintain stock: on-hand simply decrements from zero as items
 * sell, so `Current Qty` is the negative of units sold (verified on 16,229 of
 * 16,230 rows of a real export). The counter's own start date is unknown, but
 * the DIFFERENCE between two readings is exactly the units sold in between —
 * which is all a reorder needs. One row per product per reading.
 */
model ProductMovement {
  id         String   @id @default(cuid())
  locationId String
  upcNorm    String // leading-zero-stripped scan code
  takenAt    DateTime // the day of the reading
  soldUnits  Float    @default(0) // cumulative units sold, as reported

  @@unique([locationId, upcNorm, takenAt])
  @@index([locationId, takenAt])
  @@index([locationId, upcNorm])
}

/** A draft/placed order for one vendor, built from demand history. */
model PurchaseOrder {
  id         String    @id @default(cuid())
  locationId String
  vendor     String    @default("GSC")
  status     String    @default("DRAFT") // DRAFT | PLACED | CANCELLED
  /** Weeks of cover the suggestion aimed for, kept for explainability. */
  coverWeeks Float     @default(1)
  note       String?
  createdAt  DateTime  @default(now())
  /** Last time the forecast behind this draft was refreshed. */
  refreshedAt DateTime @default(now())
  placedAt   DateTime?

  lines PurchaseOrderLine[]

  @@index([locationId, vendor, status])
  @@index([locationId, createdAt])
}

model PurchaseOrderLine {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  upcNorm         String
  sku             String // vendor item number, for keying into their portal
  description     String
  department      String?
  unitsPerCase    Float         @default(1)
  caseCost        Float         @default(0)
  /** Units/week the engine measured for this product. */
  weeklyUnits     Float         @default(0)
  /** What the engine proposed. */
  suggestedCases  Float         @default(0)
  /** What will actually be ordered — owner-editable. */
  cases           Float         @default(0)
  /**
   * True once the owner has changed the quantity by hand. A daily refresh
   * updates the forecast on every line but never overwrites an edited one.
   */
  edited          Boolean       @default(false)
  /** Which signal set the quantity: measured | velocity | order-history. */
  basis           String        @default("measured")
  /** Units sold over the measured window, for "sold 40 in 28 days" context. */
  soldInWindow    Float?
  windowDays      Int?
  /** Units sold each recent week, oldest first — the evidence for the median. */
  weeklySeries    Float[]
  /** How many of those weeks had any sales. */
  weeksWithSales  Int?
  /** Cases normally bought per order, from past orders. */
  typicalCases    Float?
  /** True when the suggestion was trimmed to stay near past orders. */
  cappedByHistory Boolean       @default(false)

  @@unique([purchaseOrderId, upcNorm])
  @@index([purchaseOrderId])
}

/**
 * Units sold in ONE week, straight from the POS item-wise report (which accepts
 * a date range). Stored per week rather than as a single monthly total on
 * purpose: a month's average cannot tell "ten sold every week" apart from "ten
 * sold once and none since", and ordering against the second case is how money
 * ends up sitting on a shelf. Several weekly rows let the forecast take a
 * median, which one unusual week cannot move.
 */
model ProductDemand {
  id          String   @id @default(cuid())
  locationId  String
  upcNorm     String
  /** First day of the period this row measures (weekly periods). */
  periodStart DateTime
  periodDays  Int      @default(7)
  soldUnits   Float    @default(0) // units sold within this period
  measuredAt  DateTime @default(now())

  @@unique([locationId, upcNorm, periodStart])
  @@index([locationId, periodStart])
  @@index([locationId, upcNorm])
}
