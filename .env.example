# --- Database (Supabase / Postgres) ---
# Copy these from your Supabase dashboard:
#   Project → Connect (top bar) → ORMs → Prisma
# It gives you both strings already formatted. Replace [YOUR-PASSWORD] with your
# database password (Project Settings → Database → Database password).
#
# DATABASE_URL  = Transaction pooler (port 6543) — used by the app at runtime.
# DIRECT_URL    = Direct/session connection (port 5432) — used for migrations.

DATABASE_URL="postgresql://postgres.dgrfykdhntuyjqzsvkyb:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.dgrfykdhntuyjqzsvkyb:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Secret used to sign session JWTs. Use a long random string.
AUTH_SECRET="change-me-to-a-long-random-string"

# --- Optional integrations (all features work without these; they stay inert
#     until the relevant keys are provided) ---

# AI insights (Phase 3): if set, insights are written by Claude; otherwise a
# rule-based fallback is used.
# ANTHROPIC_API_KEY=""
# AI_MODEL="claude-sonnet-4-6"

# Modisoft POS official API (Phase 2): if set, the sync uses the live adapter
# instead of the bundled sandbox adapter. MODI_STORE_ID is optional.
# MODI_API_URL=""
# MODI_API_KEY=""
# MODI_STORE_ID=""

# Email notifications via Resend (Phase 2):
# RESEND_API_KEY=""
# NOTIFY_EMAIL_FROM="alerts@7scstore.com"

# SMS notifications via Twilio (Phase 2):
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_FROM_NUMBER=""
